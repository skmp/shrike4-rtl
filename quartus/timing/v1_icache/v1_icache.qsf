# --------------------------------------------------------------------------
# v1_icache - standalone Quartus project to place-and-route + time v1_icache alone, via
# the v1_icache_timing harness (v1_icache_timing.sv: input register bank -> v1_icache -> raw
# output capture -> one XOR-folded `digest` pin), the pattern of polly2-rtl's
# quartus/timming_tests projects. The 8 KB direct-mapped instruction cache: fetch lookup, line fills, uncached fetch, the P4 address / data arrays.
#
# Device: Cyclone V 5CSEBA6U23I7 (Terasic DE10-Nano / MiSTer).
# Build:  cd quartus/timing/v1_icache && quartus_sh --flow compile v1_icache
# Fmax:   output_files/v1_icache.sta.rpt
# --------------------------------------------------------------------------

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Standard Edition"

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED

set_global_assignment -name QIP_FILE v1_icache.files.qip
set_global_assignment -name SDC_FILE v1_icache.sdc

# the RTL's simulation-only checks are under `ifndef SYNTHESIS
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

set_global_assignment -name SEARCH_PATH .
# tp_pkg.sv includes tp_forms.svh / tp_timing.svh, fpu_vec_top.sv fpu_vec_tables.svh
set_global_assignment -name SEARCH_PATH ../../../rtl/timing-proxy
set_global_assignment -name SEARCH_PATH ../../../rtl/fpu_vec

set_global_assignment -name TOP_LEVEL_ENTITY v1_icache_timing
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top



set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
