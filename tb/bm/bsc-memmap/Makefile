# tb/bm/bsc-memmap -- bare-metal ports of the bsc-memmap console probes (WI-BSC; README.md).
#   make [OUT=dir]   builds bscmm / bscmm2 (.elf, .bin) from the console programs' own sources (tools/hw/bsc-memmap:
#                    bscmm.c, bscmm2.c, tests.S / tests.h as generated by gen_tests.py, unmodified) against shim/ +
#                    crt0.S + bmrt.c, linked at the console build's addresses (bm.ld, bm_<prog>.ld, layout.py)
# SH_ELF_PREFIX: the sh-elf toolchain (default the KOS one).
SH_ELF_PREFIX ?= /opt/toolchains/dc/sh-elf/bin/sh-elf-
CC      = $(SH_ELF_PREFIX)gcc
OBJCOPY = $(SH_ELF_PREFIX)objcopy
HW      = ../../../tools/hw/bsc-memmap
OUT    ?= ../../../build/bm/bsc-memmap
CFLAGS  = -ml -m4-single-only -O2 -ffreestanding -fno-builtin -nostdlib -Ishim -I$(HW) -Wall -Wno-unused-function -Wno-unused-const-variable -Wl,--no-warn-rwx-segments
PROGS   = bscmm bscmm2

all: $(PROGS:%=$(OUT)/%.bin)

$(OUT)/%.o: %.c | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<
$(OUT)/%.o: %.S | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<
$(OUT)/hw_%.o: $(HW)/%.c | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<
$(OUT)/hw_tests.o: $(HW)/tests.S | $(OUT)
	$(CC) $(CFLAGS) -c -o $@ $<

# bscmm's console run had KOS's code and read-only data 0xF40 below the kept ELF's (bm_bscmm.ld)
LAYOUT_bscmm = --shift '^_(irq_disable|irq_restore|K_\w+)$$=-0xF40'
RT = $(OUT)/crt0.o $(OUT)/bmrt.o $(OUT)/hw_tests.o
# bm_<prog>.ld: the console build's addresses (bm.ld); layout.py checks them against the console's ELF
$(OUT)/%.elf: $(RT) $(OUT)/hw_%.o bm.ld bm_%.ld layout.py
	$(CC) $(CFLAGS) -L. -T bm_$*.ld -o $@ $(filter %.o,$^) -lgcc
	python3 layout.py $(SH_ELF_PREFIX)nm $@ $(HW)/$*.elf $(LAYOUT_$*) || { rm -f $@; exit 1; }
$(OUT)/%.bin: $(OUT)/%.elf
	$(OBJCOPY) -O binary $< $@

$(OUT):
	mkdir -p $(OUT)
clean:
	rm -rf $(OUT)
.PHONY: all clean
.SECONDARY:
