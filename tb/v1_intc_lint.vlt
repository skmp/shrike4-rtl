`verilator_config
// v1_intc_lint.vlt -- Verilator lint waivers for WI-EXC's units (rtl/v1/v1_intc.sv, rtl/v1/v1_excregs.sv); used by
// `make v1-intc-lint` (tb/mk/v1_intc.mk).  Only the shared package is waived: v1_soc_pkg (WI-0) carries every shared
// function and constant, a unit uses a few of them, so the package's own unused-bit / unused-parameter reports are not
// about these units.  The units' own waivers are inline, each with its reason.
lint_off -rule UNUSEDSIGNAL -file "*v1_soc_pkg.sv"
lint_off -rule UNUSEDPARAM -file "*v1_soc_pkg.sv"
