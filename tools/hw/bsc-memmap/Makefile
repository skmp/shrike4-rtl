# BSC / external bus / address map measurements (spec rtl/v1/spec/bsc-memmap.md).
#   bscmm.elf  -- run 1: register dump, access widths, refresh keys, mirrors, access latencies (bscmm.c)
#   bscmm2.elf -- run 2: port pins, write sizes, refresh cost, turnarounds, TAS, line-fill beat order (bscmm2.c)
# Both share the timed kernels of tests.S (generated by gen_tests.py).
# Build: source /opt/toolchains/dc/kos/environ.sh && make ; run: HW_LOCK_WAIT=540 ../hwrun.sh bscmm.elf
all: rm-elf bscmm.elf bscmm2.elf
include $(KOS_BASE)/Makefile.rules
KOS_CFLAGS += -O2
tests.S tests.h: gen_tests.py
	python3 gen_tests.py tests.S tests.h
bscmm.o bscmm2.o: tests.h
clean: rm-elf
	-rm -f bscmm.o bscmm2.o tests.o tests.S tests.h
rm-elf:
	-rm -f bscmm.elf bscmm2.elf
bscmm.elf: bscmm.o tests.o
	kos-cc -o $@ $^
bscmm2.elf: bscmm2.o tests.o
	kos-cc -o $@ $^
