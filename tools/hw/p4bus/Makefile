# WI-P4 P4-bridge probe (rtl/v1/SOC.md 9.13): posted-write / read timing of the Pclk path at every Pclk phase.
#   source /opt/toolchains/dc/kos/environ.sh && make ; HW_LOCK_WAIT=540 ../hwrun.sh p4b.elf
# p4b_asm.S and p4b_tab.h are generated by gen.py (the make rule reruns it).
TARGETS = p4b.elf
KOS_CFLAGS += -O2
all: $(TARGETS)
include $(KOS_BASE)/Makefile.rules
p4b_asm.S p4b_tab.h: gen.py
	python3 gen.py
p4b.o: p4b.c p4b_tab.h
%.o: %.S
	kos-cc -c $< -o $@
clean:
	-rm -f $(TARGETS) *.o p4b_asm.S p4b_tab.h
p4b.elf: p4b.o p4b_asm.o
	kos-cc -o $@ $^
